# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file anywhere public.

# Port the server runs on.
PORT=4000

# How many minutes the admin has to accept/reject a new order before it
# auto-expires and the customer is notified.
ACCEPT_WINDOW_MINUTES=10

# --- Razorpay (for real online payments) -----------------------------------
# 1. Sign up free at https://dashboard.razorpay.com/signup
# 2. Complete KYC (PAN, bank account, business proof) to accept real money.
#    Until KYC is approved, Razorpay gives you TEST keys that work end-to-end
#    with fake card numbers — perfect for building and testing for free.
# 3. Dashboard -> Settings -> API Keys -> Generate Key.
# 4. Paste them below. Test keys start with "rzp_test_", live keys with "rzp_live_".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Leave the two Razorpay values blank to run the app in "Credit / Udhari only"
# mode — everything else (orders, live sync, admin accept/reject) still works.
